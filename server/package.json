{
  "name": "lh-tunnel-om-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "两湖隧道（南湖段）智能运维管理平台后端服务",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.6",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.6.1",
