# 两湖隧道智能运维后端环境变量
# 复制为 .env 后按现场修改；Windows 一键启动脚本会在缺失时自动生成 .env

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
API_PREFIX=/api/v1
APP_VERSION=1.0.0
LOG_LEVEL=info

# 现场 PostgreSQL
PGHOST=172.28.12.194
PGPORT=5432
PGUSER=postgres
PGPASSWORD=123456
PGDATABASE=lhsd_app
# 托管库需要 TLS 时置为 true
PGSSL=false
PGPOOL_MAX=10

# 启动时自动迁移与写入演示数据（幂等）
AUTO_MIGRATE=true
AUTO_SEED=true

# 生产环境建议改为随机长串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=lhsd-om-platform-dev-secret-change-me
JWT_EXPIRES_IN=12h

# 允许跨域来源，逗号分隔；* 表示不限制（演示环境）
CORS_ORIGINS=*
# 是否要求读接口也必须登录（生产建议 true）
REQUIRE_AUTH_FOR_READ=false
